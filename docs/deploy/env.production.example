# Copy this file to /tmp/beasell.env.production and replace every placeholder.
# Do not commit real production values.

CONVEX_DEPLOYMENT=prod:<deployment-name>
SITE_URL=https://<dominio>
NEXT_PUBLIC_SITE_URL=https://<dominio>
BETTER_AUTH_TRUSTED_ORIGINS=https://<dominio>
NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://<deployment>.convex.site
BETTER_AUTH_SECRET=<secret-com-pelo-menos-32-caracteres>
ADMIN_EMAILS=<email-do-dono>

# Optional monitor alert webhook. Keep real values outside the repository.
# BEASELL_MONITOR_WEBHOOK_URL=

# Optional external error tracking. Keep real values outside the repository.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
